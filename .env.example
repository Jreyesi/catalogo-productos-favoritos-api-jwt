# Servidor
PORT=3000

# PostgreSQL (Docker)
PGHOST=localhost
PGPORT=5432
PGDATABASE=catalogo_db
PGUSER=catalogo_user
PGPASSWORD=cambiar_password_local

# JWT (cambiar en local; nunca subir el valor real)
JWT_SECRET=cambiar_secreto_jwt
JWT_EXPIRES_IN=1h

# Administrador creado por el script de inicializacion
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambiar_password_admin
