{
  "name": "catalogo-productos-favoritos-api-jwt",
  "version": "1.0.0",
  "description": "API REST de catalogo de productos y favoritos con JWT y roles",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node scripts/init-db.js",
