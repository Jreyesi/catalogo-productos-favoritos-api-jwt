          "response": []
        },
        {
          "name": "Ruta protegida con token vencido",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b64 = (s) => CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(s)).replace(/=/g, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "const header = b64(JSON.stringify({alg:'HS256',typ:'JWT'}));",
                  "const payload = b64(JSON.stringify({id:1,rol:'admin',exp:Math.floor(Date.now()/1000)-10}));",
                  "const secreto = pm.environment.get('jwtSecret') || 'cambiar_secreto_jwt';",
                  "const firma = CryptoJS.HmacSHA256(header + '.' + payload, secreto);",
                  "pm.environment.set('tokenExpirado', header + '.' + payload + '.' + CryptoJS.enc.Base64.stringify(firma).replace(/=/g, '').replace(/\\+/g, '-').replace(/\\//g, '_'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 con token vencido', function () {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error).to.eql('El token ha expirado');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenExpirado}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"nombre\":\"Token vencido\",\"descripcion\":\"Prueba\",\"categoria\":\"Pruebas\",\"precio\":1}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/productos"
          },
          "response": []
        }
