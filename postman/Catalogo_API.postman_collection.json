          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"nombre\":\"Sin token\",\"descripcion\":\"Prueba\",\"categoria\":\"Pruebas\",\"precio\":1}",
